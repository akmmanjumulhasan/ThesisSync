DATABASE_URL="postgresql://postgres:1234@localhost:5432/thesissync"

# Generate your own: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET="replace-with-a-long-random-secret"

# Optional. Unset = unauthenticated GitHub API calls (60 req/hr limit).
# https://github.com/settings/tokens — no scopes needed for public profile/repo reads
# GITHUB_PERSONAL_ACCESS_TOKEN=""

# Optional. Semantic Scholar works without a key at low volume; set this to raise
# the rate limit. Request one at https://www.semanticscholar.org/product/api#api-key
SEMANTIC_SCHOLAR_API_KEY=""

# Optional. Any contact email — puts OpenAlex requests in its faster, more
# reliable "polite pool" (no signup, no key). https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication
OPENALEX_MAILTO=""

# Optional. Any contact email — puts CrossRef DOI-resolution requests in its
# faster "polite pool" (no signup, no key). Used by the Structured Thesis
# Proposal Builder (Module 1, Member 3). https://api.crossref.org/swagger-ui/index.html
CROSSREF_MAILTO=""

# Module 2 (Member 2): shared secret for the GitHub webhook behind Git-to-Task
# Contribution Analytics. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# and set the same value at the repo's Settings -> Webhooks. Without it the
# webhook route rejects every delivery.
GITHUB_WEBHOOK_SECRET=

# Optional. Repository the kanban board tracks. Defaults to this project's own repo.
GIT_ANALYTICS_REPO=

# --- Module 3 (Member 3): Smart Notification System --------------------------
# Every variable below is optional. Unset means email records SKIPPED with a
# reason instead of sending; in-app notifications always work.

# Absolute origin used for links inside emails. A relative path is useless in
# an inbox. Defaults to http://localhost:3000.
APP_ORIGIN="http://localhost:3000"


# EmailJS, for email. https://dashboard.emailjs.com
# The PRIVATE key is required: EmailJS rejects server-side calls without it
# ("API calls are disabled for non-browser applications"). Keep it server-side.
#
# The template must declare these four variables, which is what the code sends:
#   {{to_email}}  {{to_name}}  {{subject}}  {{message}}
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID=""
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""

# Shared secret for the deadline sweep, so a scheduler can call
# POST /api/notifications/deadlines with `Authorization: Bearer <secret>`.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Unset means only a signed-in supervisor can trigger the sweep by hand.
NOTIFICATIONS_CRON_SECRET=""
