generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  SUPERVISOR
  ADMIN
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// Module 1 (Member 3): Structured Thesis Proposal Builder.
enum ProposalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
}

/// Module 1 (Member 3): auto-resolution state of a cited DOI against CrossRef.
enum DoiStatus {
  PENDING
  VALIDATED
  NOT_FOUND
}

/// Module 1 (Member 3): one row per submit-or-decide event, feeding the
/// "Supervisor feedback history" timeline.
enum ProposalEvent {
  SUBMITTED
  APPROVED
  RETURNED
}

/// Common Workflow #1: Registration & Login. Shared by every module.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  studentId    String?  @unique // student ID or faculty ID, per the registration form
  department   String?
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())

  // Module 1 (Member 1): Research Landscape & Trend Analyzer
  researchQueries ResearchQuery[]

  // Module 1 (Member 2): Unified Matchmaking Engine
  studentProfile    StudentProfile?
  developerProfile  DeveloperProfile?
  supervisorProfile SupervisorProfile?
  sentRequests      MatchRequest[]     @relation("StudentRequests")
  sentInvites       TeamInvite[]       @relation("SentInvites")
  receivedInvites   TeamInvite[]       @relation("ReceivedInvites")

  // Module 3 (Member 2): AI Mock Defense Simulator (not in scope here, kept for teammates)
  defenseSessions MockDefenseSession[]

  // Module 1 (Member 3): Structured Thesis Proposal Builder
  proposal        ThesisProposal?        @relation("StudentProposal")
  proposalHistory ProposalHistoryEntry[] @relation("ProposalActor")
}

/// Module 1 (Member 1): Research Landscape & Trend Analyzer.
/// One row per "map the landscape" run: the topic searched, the derived
/// coverage summary, and the field-growth verdict shown to the student.
model ResearchQuery {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic            String
  heavilyCovered   String[] @default([])
  understudiedGaps String[] @default([])
  fieldStatus      String   @default("active") // "growing" | "active" | "saturating"
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}

/// Student-only fields used by the Unified Matchmaking Engine:
/// researchKeywords power Supervisor mode, declaredSkills power Teammate mode.
model StudentProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  researchKeywords String[] @default([])
  declaredSkills   String[] @default([])
  openToTeam       Boolean  @default(true)
  teamPost         String?
  updatedAt        DateTime @updatedAt
}

/// GitHub-verified developer signal for Teammate mode. A student only enters the
/// match pool once isVerified is true (see /api/github/verify).
model DeveloperProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubUsername  String   @unique
  isVerified      Boolean  @default(false)
  topLanguages    String[] @default([])
  totalCommits    Int      @default(0)
  topRepositories String[] @default([])
  updatedAt       DateTime @updatedAt
}

/// Faculty-only fields used by Supervisor mode matching.
model SupervisorProfile {
  id                String         @id @default(uuid())
  userId            String         @unique
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  researchInterests String[]       @default([])
  maxLoad           Int            @default(5)
  activeLoad        Int            @default(0)
  isAvailable       Boolean        @default(true)
  avgResponseDays   Float          @default(3)
  receivedRequests  MatchRequest[] @relation("SupervisorRequests")
}

/// Supervisor mode: a student sends a supervision request directly from the ranked list.
model MatchRequest {
  id           String            @id @default(uuid())
  studentId    String
  student      User              @relation("StudentRequests", fields: [studentId], references: [id], onDelete: Cascade)
  supervisorId String
  supervisor   SupervisorProfile @relation("SupervisorRequests", fields: [supervisorId], references: [id], onDelete: Cascade)
  status       RequestStatus     @default(PENDING)
  createdAt    DateTime          @default(now())

  @@unique([studentId, supervisorId])
}

/// Teammate mode: a student invites another GitHub-verified student to team up.
model TeamInvite {
  id         String        @id @default(uuid())
  fromUserId String
  from       User          @relation("SentInvites", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  to         User          @relation("ReceivedInvites", fields: [toUserId], references: [id], onDelete: Cascade)
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())

  @@unique([fromUserId, toUserId])
}

/// Module 1 (Member 3): Structured Thesis Proposal Builder (API: CrossRef).
/// One row per student — the proposal is a single mandatory gate that gets
/// revised in place (see ProposalHistoryEntry for the version/feedback
/// timeline) rather than resubmitted as a new record each time.
///
/// title/abstract/methodology/limitations predate this feature (added as a
/// placeholder for Module 3 (Member 2)'s Mock Defense Simulator, which reads
/// a proposal's content as AI context) and are kept, now default-valued, so
/// that still-planned feature isn't blocked by this one shipping first.
model ThesisProposal {
  id          String @id @default(uuid())
  title       String @default("")
  abstract    String @default("")
  methodology String @default("")
  limitations String @default("")

  studentId String @unique
  student   User   @relation("StudentProposal", fields: [studentId], references: [id], onDelete: Cascade)

  problemStatement     String         @default("")
  researchObjectives   String         @default("")
  methodologyOutline   String         @default("")
  expectedContribution String         @default("")
  status               ProposalStatus @default(DRAFT)
  version              Int            @default(1)
  submittedAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  references ProposalReference[]
  history    ProposalHistoryEntry[]
  sessions   MockDefenseSession[]
}

/// A cited DOI on a proposal, auto-resolved against CrossRef's public Works API.
model ProposalReference {
  id            String         @id @default(uuid())
  proposalId    String
  proposal      ThesisProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  doi           String
  resolvedTitle String?
  resolvedVenue String?
  resolvedYear  Int?
  status        DoiStatus      @default(PENDING)
  createdAt     DateTime       @default(now())
}

/// The "Supervisor feedback history" timeline: a submission event (student,
/// no comment) or a decision event (supervisor, with remarks), one per
/// proposal version.
model ProposalHistoryEntry {
  id         String         @id @default(uuid())
  proposalId String
  proposal   ThesisProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  version    Int
  event      ProposalEvent
  comment    String?
  actorId    String?
  actor      User?          @relation("ProposalActor", fields: [actorId], references: [id])
  createdAt  DateTime       @default(now())
}

model MockDefenseSession {
  id           String               @id @default(uuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposalId   String
  proposal     ThesisProposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  isActive     Boolean              @default(true)
  overallScore Float?
  interactions DefenseInteraction[]
  createdAt    DateTime             @default(now())
}

model DefenseInteraction {
  id         String             @id @default(uuid())
  sessionId  String
  session    MockDefenseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question   String
  answer     String?
  evaluation String?
  score      Float?
  createdAt  DateTime           @default(now())
}
