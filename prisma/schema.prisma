generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  SUPERVISOR
  ADMIN
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// Module 1 (Member 3): Structured Thesis Proposal Builder.
enum ProposalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
}

/// Module 1 (Member 3): auto-resolution state of a cited DOI against CrossRef.
enum DoiStatus {
  PENDING
  VALIDATED
  NOT_FOUND
}

/// Module 1 (Member 3): one row per submit-or-decide event, feeding the
/// "Supervisor feedback history" timeline.
enum ProposalEvent {
  SUBMITTED
  APPROVED
  RETURNED
}

/// Module 2 (Member 1): Automated Evaluation & LaTeX Chart Generator.
/// Whether the uploaded predicted/actual columns resolved to exactly two
/// labels (classic TP/FP/TN/FN formulas apply) or more (macro/weighted
/// averages apply instead). Kept on the run so the client doesn't have to
/// re-derive it from labels.length.
enum EvaluationKind {
  BINARY
  MULTICLASS
}

/// Common Workflow #1: Registration & Login. Shared by every module.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  studentId    String?  @unique // student ID or faculty ID, per the registration form
  department   String?
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())

  // Module 1 (Member 1): Research Landscape & Trend Analyzer
  researchQueries ResearchQuery[]

  // Module 1 (Member 2): Unified Matchmaking Engine
  studentProfile    StudentProfile?
  developerProfile  DeveloperProfile?
  supervisorProfile SupervisorProfile?
  sentRequests      MatchRequest[]     @relation("StudentRequests")
  sentInvites       TeamInvite[]       @relation("SentInvites")
  receivedInvites   TeamInvite[]       @relation("ReceivedInvites")

  // Module 3 (Member 2): AI Mock Defense Simulator (not in scope here, kept for teammates)
  defenseSessions MockDefenseSession[]

  // Module 1 (Member 3): Structured Thesis Proposal Builder
  proposal        ThesisProposal?        @relation("StudentProposal")
  proposalHistory ProposalHistoryEntry[] @relation("ProposalActor")

  // Module 2 (Member 1): Automated Evaluation & LaTeX Chart Generator
  evaluationRuns EvaluationRun[]

  // Module 2 (Member 2): Git-to-Task Contribution Analytics
  assignedTasks KanbanTask[]       @relation("TaskAssignee")
  repoAccess    RepositoryAccess[] @relation("RepoAccess")

  // Module 1 (Member 2): supervisor-approved teammate removal
  removalRequestsMade     TeamRemovalRequest[] @relation("RemovalRequester")
  removalRequestsAgainst  TeamRemovalRequest[] @relation("RemovalTarget")

  // Module 2 (Member 3): Topic Novelty & Similarity Checker
  noveltyChecks NoveltyCheck[] @relation("NoveltyChecks")

  // Module 3 (Member 3): Chapter Approval Workflow
  chapters     ThesisChapter[]     @relation("StudentChapters")
  chapterAudit ChapterAuditEntry[] @relation("ChapterActor")
}

/// Module 1 (Member 1): Research Landscape & Trend Analyzer.
/// One row per "map the landscape" run: the topic searched, the derived
/// coverage summary, and the field-growth verdict shown to the student.
model ResearchQuery {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic            String
  heavilyCovered   String[] @default([])
  understudiedGaps String[] @default([])
  fieldStatus      String   @default("active") // "growing" | "active" | "saturating"
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}

/// Module 2 (Member 1): Automated Evaluation & LaTeX Chart Generator.
/// One row per uploaded results CSV: the derived confusion matrix and metrics
/// are stored as-computed (rather than re-derived from raw rows on every
/// view) since the source CSV itself isn't persisted — only its summary is.
model EvaluationRun {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  datasetName     String
  rowCount        Int
  kind            EvaluationKind
  labels          String[]       @default([])
  /// { labels: string[], matrix: number[][] } — matrix[actualIdx][predictedIdx]
  confusionMatrix Json
  /// { accuracy, macroPrecision, macroRecall, macroF1, weightedPrecision,
  ///   weightedRecall, weightedF1, perClass: [...], binary?: {...},
  ///   roc?: { points: [...], auc } } — roc only present for binary runs
  /// that included a score/probability column.
  metrics         Json
  createdAt       DateTime       @default(now())

  @@index([userId, createdAt])
}

/// Student-only fields used by the Unified Matchmaking Engine:
/// researchKeywords power Supervisor mode, declaredSkills power Teammate mode.
model StudentProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  researchKeywords String[] @default([])
  declaredSkills   String[] @default([])
  openToTeam       Boolean  @default(true)
  teamPost         String?
  updatedAt        DateTime @updatedAt
}

/// GitHub-verified developer signal for Teammate mode. A student only enters the
/// match pool once isVerified is true (see /api/github/verify).
model DeveloperProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubUsername  String   @unique
  isVerified      Boolean  @default(false)
  topLanguages    String[] @default([])
  totalCommits    Int      @default(0)
  topRepositories String[] @default([])
  updatedAt       DateTime @updatedAt
}

/// Faculty-only fields used by Supervisor mode matching.
model SupervisorProfile {
  id                String         @id @default(uuid())
  userId            String         @unique
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  researchInterests String[]       @default([])
  maxLoad           Int            @default(5)
  activeLoad        Int            @default(0)
  isAvailable       Boolean        @default(true)
  avgResponseDays   Float          @default(3)
  receivedRequests  MatchRequest[] @relation("SupervisorRequests")

  // Module 1 (Member 2): teammate removals awaiting this supervisor's decision
  removalDecisions TeamRemovalRequest[] @relation("RemovalDecisions")
}

/// Supervisor mode: a student sends a supervision request directly from the ranked list.
model MatchRequest {
  id           String            @id @default(uuid())
  studentId    String
  student      User              @relation("StudentRequests", fields: [studentId], references: [id], onDelete: Cascade)
  supervisorId String
  supervisor   SupervisorProfile @relation("SupervisorRequests", fields: [supervisorId], references: [id], onDelete: Cascade)
  status       RequestStatus     @default(PENDING)
  createdAt    DateTime          @default(now())

  @@unique([studentId, supervisorId])
}

/// Teammate mode: a student invites another GitHub-verified student to team up.
model TeamInvite {
  id         String        @id @default(uuid())
  fromUserId String
  from       User          @relation("SentInvites", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  to         User          @relation("ReceivedInvites", fields: [toUserId], references: [id], onDelete: Cascade)
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())

  @@unique([fromUserId, toUserId])
}

/// Module 1 (Member 3): Structured Thesis Proposal Builder (API: CrossRef).
/// One row per student — the proposal is a single mandatory gate that gets
/// revised in place (see ProposalHistoryEntry for the version/feedback
/// timeline) rather than resubmitted as a new record each time.
///
/// title/abstract are the thesis's identity, and the proposal form collects
/// them: they are required to submit. Downstream modules read them rather than
/// inventing their own — Module 3 (Member 2)'s Mock Defense Simulator uses them
/// as the examiner's context, and its IEEE Paper Transpiler loads them as the
/// paper's title and abstract. They were default-valued placeholders until the
/// form asked for them, which meant both of those readers silently got "".
///
/// methodology/limitations still predate this feature and remain default-valued;
/// methodologyOutline superseded methodology.
model ThesisProposal {
  id          String @id @default(uuid())
  title       String @default("")
  abstract    String @default("")
  methodology String @default("")
  limitations String @default("")

  studentId String @unique
  student   User   @relation("StudentProposal", fields: [studentId], references: [id], onDelete: Cascade)

  problemStatement     String         @default("")
  researchObjectives   String         @default("")
  methodologyOutline   String         @default("")
  expectedContribution String         @default("")
  status               ProposalStatus @default(DRAFT)
  version              Int            @default(1)
  submittedAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  references ProposalReference[]
  history    ProposalHistoryEntry[]
  sessions   MockDefenseSession[]
}

/// A cited DOI on a proposal, auto-resolved against CrossRef's public Works API.
model ProposalReference {
  id            String         @id @default(uuid())
  proposalId    String
  proposal      ThesisProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  doi           String
  resolvedTitle String?
  resolvedVenue String?
  resolvedYear  Int?
  status        DoiStatus      @default(PENDING)
  createdAt     DateTime       @default(now())
}

/// The "Supervisor feedback history" timeline: a submission event (student,
/// no comment) or a decision event (supervisor, with remarks), one per
/// proposal version.
model ProposalHistoryEntry {
  id         String         @id @default(uuid())
  proposalId String
  proposal   ThesisProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  version    Int
  event      ProposalEvent
  comment    String?
  actorId    String?
  actor      User?          @relation("ProposalActor", fields: [actorId], references: [id])
  createdAt  DateTime       @default(now())
}

model MockDefenseSession {
  id           String               @id @default(uuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposalId   String
  proposal     ThesisProposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  isActive     Boolean              @default(true)
  overallScore Float?
  /// The examiner's reading of the thesis, produced before any question is
  /// written. Kept so a session's questions can be traced back to the weakness
  /// that motivated them rather than appearing arbitrary.
  analysis     String?
  interactions DefenseInteraction[]
  createdAt    DateTime             @default(now())
}

/// Module 3 (Member 2): one question in a mock defense, and how it went.
model DefenseInteraction {
  id              String             @id @default(uuid())
  sessionId       String
  session         MockDefenseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question        String
  /// What the student replied. Null until they answer.
  answer          String?
  evaluation      String?
  score           Float?
  /// The answer the thesis itself supports, written when the question was, so
  /// a student can compare their reply against what their own work already
  /// says instead of guessing what the examiner wanted.
  referenceAnswer String?
  /// Which mandated area this probes: LIMITATIONS, DATA_VALIDATION, ETHICS or
  /// METHODOLOGY. Stored so a session can be shown to cover all four.
  focus           String?
  /// Ask order. Questions are written in one batch, so createdAt ties.
  position        Int                @default(0)
  createdAt       DateTime           @default(now())

  @@index([sessionId, position])
}

/// Module 2 (Member 2): Git-to-Task Contribution Analytics.
/// The four kanban columns. Order here is the board's left-to-right order.
enum TaskStatus {
  BACKLOG
  IN_PROGRESS
  IN_REVIEW
  DONE
}

/// Module 2 (Member 2): what arrived from GitHub — a pushed commit or a pull
/// request action. Kept separate from TaskStatus because an event can reference
/// no task at all and still belongs in the activity feed and the heatmap.
enum GitEventType {
  PUSH
  PULL_REQUEST
}

/// Module 2 (Member 2): a card on the team kanban board.
///
/// `key` ("TS-11") is what a commit message references — that string is the
/// whole contract between git and this board, so it's unique and immutable once
/// created. Status moves either by hand or automatically when a webhook payload
/// carries a matching reference (see GitEvent.movedTaskTo).
model KanbanTask {
  id         String     @id @default(uuid())
  key        String     @unique
  title      String
  status     TaskStatus @default(BACKLOG)
  repo       String
  assigneeId String?
  assignee   User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Human-readable trace of the last automated move ("closed via commit a1c9f2"),
  /// shown on the card so an auto-transition is never unexplained.
  autoNote   String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  events GitEvent[]

  @@index([repo, status])
}

/// Module 2 (Member 2): one row per commit pushed or pull-request action, the
/// raw material behind the heatmap, the per-member chart, and the activity feed.
///
/// `externalId` ("push:<sha>", "pr:22:opened") is the idempotency key: webhook
/// delivery and API backfill can both report the same event, and re-running a
/// sync must not inflate anyone's commit count.
model GitEvent {
  id          String       @id @default(uuid())
  externalId  String       @unique
  type        GitEventType
  repo        String
  /// GitHub login of whoever authored it. Resolved to a platform user at read
  /// time via DeveloperProfile.githubUsername rather than by foreign key, so
  /// contributors without a ThesisSync account still appear in the analytics.
  actorLogin  String
  actorName   String?
  message     String
  sha         String?
  prNumber    Int?
  prState     String?
  branch      String?
  url         String?
  occurredAt  DateTime
  taskId      String?
  task        KanbanTask?  @relation(fields: [taskId], references: [id], onDelete: SetNull)
  /// Set only when this event actually caused a column change, so the activity
  /// feed can distinguish "mentioned TS-11" from "moved TS-11 to Done".
  movedTaskTo TaskStatus?
  createdAt   DateTime     @default(now())

  @@index([repo, occurredAt])
  @@index([actorLogin, occurredAt])
}

/// Module 1 (Member 2): removing a teammate is not unilateral — a student asks,
/// and their supervisor decides. One row per request, kept after the decision so
/// the team's history stays auditable rather than silently rewritten.
///
/// Approval is what actually severs the team link: it deletes the ACCEPTED
/// TeamInvite rows between the two students (both directions). The pair can be
/// re-invited afterwards, which is why the invite rows are removed rather than
/// flipped to DECLINED — a stale DECLINED row would block a fresh invite via the
/// @@unique([fromUserId, toUserId]) constraint.
model TeamRemovalRequest {
  id           String            @id @default(uuid())
  requesterId  String
  requester    User              @relation("RemovalRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  targetId     String
  target       User              @relation("RemovalTarget", fields: [targetId], references: [id], onDelete: Cascade)
  /// The supervisor whose approval is required: the requester's accepted
  /// supervisor at the time of asking. Stored rather than derived so a later
  /// supervision change can't silently reassign a pending decision.
  supervisorId String
  supervisor   SupervisorProfile @relation("RemovalDecisions", fields: [supervisorId], references: [id], onDelete: Cascade)
  reason       String
  status       RequestStatus     @default(PENDING)
  /// Supervisor's note on the decision, shown back to the requester.
  decisionNote String?
  decidedAt    DateTime?
  createdAt    DateTime          @default(now())

  @@index([supervisorId, status])
  @@index([requesterId, status])
}

/// Module 2 (Member 2): how a user proved they may see a repository's analytics.
enum RepoAccessRole {
  OWNER
  COLLABORATOR
  CONTRIBUTOR
}

/// Module 2 (Member 2): a repository a user has connected to the analytics board.
///
/// This row *is* the authorization record. Every read of a repo's tasks, events,
/// heatmap, or activity checks for one, so a user can never see analytics for a
/// repository they have no standing on — searching for a stranger's repo returns
/// nothing rather than someone else's contribution data.
///
/// Access is re-checked against GitHub when the repo is connected, and the role
/// that proved it is kept for display. Boards themselves stay keyed by the repo
/// full name, so teammates who each connect the same repo share one board.
model RepositoryAccess {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation("RepoAccess", fields: [userId], references: [id], onDelete: Cascade)
  /// "owner/name", exactly as GitHub canonicalises it.
  fullName   String
  role       RepoAccessRole
  /// The GitHub login the check was made against, so a later re-verification
  /// against a different account is visibly a different claim.
  githubLogin String
  isPrivate  Boolean        @default(false)
  verifiedAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  @@unique([userId, fullName])
  @@index([fullName])
}

/// Module 2 (Member 3): how risky a similarity result is, banded so the UI and
/// the supervisor-attention rule agree on one threshold rather than each
/// hard-coding their own.
enum SimilarityRisk {
  LOW
  MODERATE
  HIGH
}

/// Module 2 (Member 3): what the novelty checker was asked to score.
enum NoveltyCheckKind {
  TITLE_ABSTRACT
  CHAPTER_DRAFT
}

/// Module 3 (Member 1): the University Thesis Repository's corpus.
///
/// Added here because the Topic Novelty & Similarity Checker is scored against
/// it — the spec has the repository powering the similarity feature, so the
/// corpus has to exist before the checker means anything. The repository's own
/// search UI is still Module 3's to build; this is only the archive it reads.
model ArchivedThesis {
  id         String   @id @default(uuid())
  title      String
  abstract   String
  /// Where this record came from, so a match can always be traced back to a
  /// real document. Records imported from OpenAlex carry their DOI and landing
  /// page; theses deposited by the university carry their own identifier.
  source     String   @default("MANUAL")
  sourceUrl  String?
  doi        String?
  /// Full text when the archive holds it. Similarity scores against abstract +
  /// content, so a thesis with content stored is matched on far more signal.
  content    String?
  department String
  year       Int
  supervisor String?
  keywords   String[] @default([])
  createdAt  DateTime @default(now())

  matches SimilarityMatch[]

  @@index([department, year])
}

/// Module 2 (Member 3): one run of the checker, kept so a student can see what
/// they submitted before and a supervisor can review the trail.
model NoveltyCheck {
  id     String           @id @default(uuid())
  userId String
  user   User             @relation("NoveltyChecks", fields: [userId], references: [id], onDelete: Cascade)
  kind   NoveltyCheckKind

  /// Title/abstract runs carry both; draft runs carry the source file name.
  title      String?
  abstract   String?
  sourceName String?
  /// Word count of what was actually scored, so a near-empty upload is visible
  /// rather than silently producing a flattering score.
  wordCount  Int    @default(0)

  /// 0-100, higher is more novel. Title/abstract runs only.
  noveltyScore   Int?
  /// 0-100 highest cosine similarity found against the archive.
  topSimilarity  Int            @default(0)
  risk           SimilarityRisk @default(LOW)
  /// Angles the corpus barely covers, and methodologies it already covers.
  understudied   String[]       @default([])
  alreadyCovered String[]       @default([])
  /// How many archived theses and external papers this was scored against, so
  /// the number shown to the student is the real corpus size at run time.
  archiveSize    Int            @default(0)
  externalSize   Int            @default(0)
  /// The published papers this run actually matched: [{ title, venue, year,
  /// url, score }]. Stored so a result stays checkable after the fact, rather
  /// than collapsing into a single opaque percentage.
  externalMatches Json?

  createdAt DateTime @default(now())

  matches SimilarityMatch[]

  @@index([userId, createdAt])
}

/// Module 2 (Member 3): a single archived thesis a run matched against.
model SimilarityMatch {
  id       String       @id @default(uuid())
  checkId  String
  check    NoveltyCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)
  thesisId String
  thesis   ArchivedThesis @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  /// 0-100 cosine similarity.
  score    Int
  /// The terms that drove the overlap, so a flagged match can be explained
  /// rather than just asserted.
  sharedTerms String[] @default([])

  @@unique([checkId, thesisId])
}

/// Module 2 (Member 3): cached literature-search results.
///
/// The novelty score is only as stable as the evidence behind it, and the
/// scholarly APIs are not stable: Semantic Scholar rate-limits intermittently,
/// and Crossref and OpenAlex return slightly different sets each call. The same
/// proposal checked twice was scoring 80% then 76% purely because a different
/// sample of papers came back — a student cannot act on a verdict that moves
/// under them.
///
/// Caching the retrieval makes a repeat check deterministic, and cuts the API
/// load that causes the rate limiting in the first place. Entries expire so a
/// re-check weeks later still reflects newly published work.
model LiteratureCache {
  id        String   @id @default(uuid())
  /// SHA-256 of the normalised query set.
  queryHash String   @unique
  /// The queries this covers, kept for debugging a surprising result.
  queries   String[] @default([])
  /// ExternalPaper[] exactly as fetched.
  payload   Json
  sources   String[] @default([])
  fetchedAt DateTime @default(now())

  @@index([fetchedAt])
}

/// Module 3 (Member 3): Chapter Approval Workflow.
///
/// The five pipeline stages, in order. A chapter never skips one: the only
/// legal moves are the ones enumerated in src/lib/chapters.ts, and every move
/// past DRAFT is made by the supervisor, never by the system and never by the
/// student.
///
/// APPROVED and LOCKED are deliberately different in kind, not just in name.
/// APPROVED means the supervisor accepts the content, and is reversible: the
/// student may withdraw it to amend (which cancels the approval), and the
/// supervisor may take it back. LOCKED is the commitment of the chapter to the
/// final thesis.
///
/// LOCKED is therefore terminal, and it is the only state that is. Nothing
/// transitions out of it, for either party — a locked chapter that turned out
/// to be wrong is corrected as a matter of record, not by quietly reopening the
/// row. This is the state the requirement means by "the student cannot make
/// further edits", and it does real work precisely because APPROVED does not
/// already freeze the chapter.
enum ChapterStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  LOCKED
}

/// Module 3 (Member 3): what a ChapterAuditEntry records.
///
/// This is deliberately not the same set as ChapterStatus. RETURNED and
/// REOPENED are events with no matching state (both land the chapter back in
/// DRAFT), and CREATED marks the chapter's existence rather than a transition —
/// all three are needed for the trail to read as a complete history rather than
/// a status log.
///
/// REOPENED is the student withdrawing their own approved chapter to amend it.
/// It is recorded separately from RETURNED so the trail always distinguishes
/// "the supervisor sent this back" from "the student pulled this back", which
/// are very different facts about who was dissatisfied.
enum ChapterEvent {
  CREATED
  SUBMITTED
  REVIEW_STARTED
  APPROVED
  RETURNED
  REOPENED
  LOCKED
}

/// Module 3 (Member 3): one chapter of a student's thesis, moving through the
/// approval pipeline.
///
/// Content is edited in place rather than versioned per submission — draft
/// history and inline comments are Module 3 (Member 1)'s Version Control &
/// Inline Annotation feature, and duplicating a weaker version of it here would
/// put two disagreeing histories in the same database. What this model owns is
/// the *approval* record: which stage the chapter is at, and who moved it
/// there.
///
/// `version` counts submission rounds, so a chapter returned twice and approved
/// on the third attempt reads as v3 in the trail. It matches ThesisProposal's
/// meaning of the same field.
model ThesisChapter {
  id        String @id @default(uuid())
  studentId String
  student   User   @relation("StudentChapters", fields: [studentId], references: [id], onDelete: Cascade)

  /// 1-based position in the thesis. Unique per student, and renumbered when a
  /// draft chapter is removed so the ordering never develops holes.
  number  Int
  title   String
  content String @default("")

  status  ChapterStatus @default(DRAFT)
  version Int           @default(1)

  /// When the current round was submitted. Orders the supervisor's queue oldest
  /// first, so the chapter that has been waiting longest is reviewed first.
  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  audit ChapterAuditEntry[]

  @@unique([studentId, number])
  @@index([studentId, status])
}

/// Module 3 (Member 3): one row per stage transition — the audit trail.
///
/// Append-only by construction: nothing in the app updates or deletes a row
/// here, because the accountability the feature promises is worth nothing if
/// the record can be edited after the fact. A chapter can only be deleted
/// before it has ever been submitted, which is the one case where there is no
/// approval history to destroy.
///
/// fromStatus/toStatus are stored rather than derived from the neighbouring
/// rows so a single entry is independently readable, and so the trail survives
/// any later change to the pipeline's shape.
///
/// actorRole is captured at write time. A user's role could in principle change
/// later, and "approved by a supervisor" must stay true about the moment the
/// approval happened.
model ChapterAuditEntry {
  id        String        @id @default(uuid())
  chapterId String
  chapter   ThesisChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  event      ChapterEvent
  /// Null on CREATED, which has no prior state.
  fromStatus ChapterStatus?
  toStatus   ChapterStatus
  /// The submission round this happened in.
  version    Int            @default(1)

  /// Required on RETURNED — a chapter is never sent back without a reason.
  comment String?

  /// Nullable so a deleted account never takes the approval record with it.
  actorId   String?
  actor     User?    @relation("ChapterActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// Denormalised so the trail still names its actor after an account is gone.
  actorName String
  actorRole Role

  createdAt DateTime @default(now())

  @@index([chapterId, createdAt])
}
